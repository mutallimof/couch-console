# Couch Console settings. Everything here is OPTIONAL: the console works with no .env file at all.
# To use one: copy this file to ".env" (same folder) and fill in what you want. ".env" is never committed to git.
# Leave a line empty (or delete it) to not use it.

# YouTube search in the Video and Music channels. Without a key you can still paste YouTube links; only the search box is off.
# Get a free key: https://console.cloud.google.com -> create a project -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=

# The port the console listens on (default 3000), and the secure https one used with `npm run certs` (default 3443).
PORT=
HTTPS_PORT=

# This laptop's Wi-Fi address, if the one shown for the phones' QR code is the wrong one (for example 192.168.1.23).
LAN_IP=

# A public https link that reaches this console (what `npm run tunnel` sets for you). The QR code then sends phones there.
PUBLIC_URL=

# Where the party's photos, slides and settings are saved (default: the "data" folder in this project).
DATA_DIR=
