    "pixi.js": "^8.22.0",
    "postprocessing": "6.39.5",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "three": "0.186.1",
    "three.quarks": "0.17.1"
  },
  "devDependencies": {
